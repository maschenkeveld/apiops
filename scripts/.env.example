# Copy to scripts/.env (gitignored) and fill in. Used by deploy / verify / publish.
# build / lint / validate need none of these.

# Konnect PAT (kpat_...). Required for deploy, verify, publish.
KONNECT_TOKEN=

# Dev Portal ID. Required only for publish.
# Get it from the portal Terraform stack: `terraform output portal_id`
# (in CI this is the KONNECT_PORTAL_ID GitHub variable).
PORTAL_ID=

# Optional: override the Konnect region host (defaults to https://eu.api.konghq.com)
# KONNECT_ADDR=https://eu.api.konghq.com
